const express = require('express');
const router = express.Router();
const {
  requestResetPassword,
  verifyResetToken,
  resetPassword
} = require('../controllers/forgotPasswordController');

// POST /forgot-password/request - Request reset password
router.post('/request', requestResetPassword);

// GET /forgot-password/verify/:token - Verify reset token
router.get('/verify/:token', verifyResetToken);

// POST /forgot-password/reset - Reset password
router.post('/reset', resetPassword);

module.exports = router;