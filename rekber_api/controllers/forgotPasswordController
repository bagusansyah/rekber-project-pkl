const pool = require('../config/db');
const bcrypt = require('bcryptjs');
const crypto = require('crypto');
const { sendEmail } = require('../utils/email');

// REQUEST RESET PASSWORD
async function requestResetPassword(req, res) {
  try {
    const { email } = req.body;

    // Validasi input
    if (!email) {
      return res.status(400).json({
        status: false,
        error: "Email wajib diisi"
      });
    }

    // Cek apakah email terdaftar
    const userResult = await pool.query(
      "SELECT id, name, email FROM users WHERE email = $1",
      [email]
    );

    if (userResult.rows.length === 0) {
      return res.status(404).json({
        status: false,
        error: "Email tidak terdaftar dalam sistem"
      });
    }

    const user = userResult.rows[0];

    // Generate reset token
    const resetToken = crypto.randomBytes(32).toString('hex');
    const resetTokenExpiry = new Date(Date.now() + 3600000); // 1 hour from now

    // Simpan reset token ke database
    await pool.query(`
      INSERT INTO password_reset_tokens (user_id, token, expires_at) 
      VALUES ($1, $2, $3)
      ON CONFLICT (user_id) 
      DO UPDATE SET token = $2, expires_at = $3, created_at = NOW()
    `, [user.id, resetToken, resetTokenExpiry]);

    // Buat reset URL
    const resetUrl = `https://www.rekber.com/reset-password?token=${resetToken}`;

    // Kirim email reset password
    const emailSubject = 'Reset Password - Rekber.com';
    const emailHtml = `
      <div style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;">
        <h2 style="color: #333; text-align: center;">Reset Password</h2>
        
        <p>Halo ${user.name},</p>
        
        <p>Kami menerima permintaan untuk mereset password akun Anda di Rekber.com.</p>
        
        <p>Klik tombol di bawah ini untuk mereset password Anda:</p>
        
        <div style="text-align: center; margin: 30px 0;">
          <a href="${resetUrl}" 
             style="background-color: #007bff; color: white; padding: 12px 30px; 
                    text-decoration: none; border-radius: 5px; display: inline-block;">
            Reset Password
          </a>
        </div>
        
        <p>Atau copy dan paste link berikut ke browser Anda:</p>
        <p style="word-break: break-all; color: #007bff;">${resetUrl}</p>
        
        <p><strong>Link ini akan kedaluwarsa dalam 1 jam.</strong></p>
        
        <p>Jika Anda tidak meminta reset password, abaikan email ini. Password Anda tidak akan berubah.</p>
        
        <hr style="margin: 30px 0; border: none; border-top: 1px solid #eee;">
        <p style="color: #666; font-size: 12px; text-align: center;">
          Email ini dikirim secara otomatis. Jangan balas email ini.
        </p>
      </div>
    `;

    await sendEmail(user.email, emailSubject, emailHtml);

    return res.status(200).json({
      status: true,
      message: "Link reset password telah dikirim ke email Anda. Silakan periksa email dan ikuti instruksi untuk mereset password.",
      data: {
        email: user.email,
        expires_in: "1 jam"
      }
    });

  } catch (err) {
    console.error('Request reset password error:', err);
    return res.status(500).json({
      status: false,
      error: "Internal server error"
    });
  }
}

// VERIFY RESET TOKEN
async function verifyResetToken(req, res) {
  try {
    const { token } = req.params;

    if (!token) {
      return res.status(400).json({
        status: false,
        error: "Token reset password wajib diisi"
      });
    }

    // Cek token di database
    const tokenResult = await pool.query(`
      SELECT prt.*, u.name, u.email 
      FROM password_reset_tokens prt
      JOIN users u ON prt.user_id = u.id
      WHERE prt.token = $1 AND prt.expires_at > NOW()
    `, [token]);

    if (tokenResult.rows.length === 0) {
      return res.status(400).json({
        status: false,
        error: "Token reset password tidak valid atau sudah kedaluwarsa"
      });
    }

    const tokenData = tokenResult.rows[0];

    return res.status(200).json({
      status: true,
      message: "Token valid",
      data: {
        user_name: tokenData.name,
        user_email: tokenData.email,
        expires_at: tokenData.expires_at
      }
    });

  } catch (err) {
    console.error('Verify reset token error:', err);
    return res.status(500).json({
      status: false,
      error: "Internal server error"
    });
  }
}

// RESET PASSWORD
async function resetPassword(req, res) {
  try {
    const { token, password, confirmPassword } = req.body; 
    // Validasi input
    if (!token || !password || !confirmPassword) {
      return res.status(400).json({
        status: false,
        error: "Token, password baru, dan konfirmasi password wajib diisi"
      });
    }

    if (password !== confirmPassword) {
      return res.status(400).json({
        status: false,
        error: "Password baru dan konfirmasi password tidak sama"
      });
    }

    if (password.length < 6) {
      return res.status(400).json({
        status: false,
        error: "Password minimal 6 karakter"
      });
    }

    // Cek token di database
    const tokenResult = await pool.query(`
      SELECT prt.*, u.name, u.email 
      FROM password_reset_tokens prt
      JOIN users u ON prt.user_id = u.id
      WHERE prt.token = $1 AND prt.expires_at > NOW()
    `, [token]);

    if (tokenResult.rows.length === 0) {
      return res.status(400).json({
        status: false,
        error: "Token reset password tidak valid atau sudah kedaluwarsa"
      });
    }

    const tokenData = tokenResult.rows[0];

    // Hash password baru
    const hashedPassword = await bcrypt.hash(password, 10);

    // Update password user
    await pool.query(
      "UPDATE users SET password = $1 WHERE id = $2",
      [hashedPassword, tokenData.user_id]
    );

    // Hapus token yang sudah digunakan
    await pool.query(
      "DELETE FROM password_reset_tokens WHERE user_id = $1",
      [tokenData.user_id]
    );

    // Kirim email konfirmasi password berhasil direset
    const emailSubject = 'Password Berhasil Direset - Rekber.com';
    const emailHtml = `
      <div style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;">
        <h2 style="color: #28a745; text-align: center;">Password Berhasil Direset</h2>
        
        <p>Halo ${tokenData.name},</p>
        
        <p>Password akun Anda di Rekber.com telah berhasil direset pada ${new Date().toLocaleString('id-ID')}.</p>
        
        <p>Anda sekarang dapat login menggunakan password baru Anda.</p>
        
        <div style="text-align: center; margin: 30px 0;">
          <a href="https://www.rekber.com/login" 
             style="background-color: #28a745; color: white; padding: 12px 30px; 
                    text-decoration: none; border-radius: 5px; display: inline-block;">
            Login Sekarang
          </a>
        </div>
        
        <p>Jika Anda tidak mereset password ini, segera hubungi customer service kami.</p>
        
        <hr style="margin: 30px 0; border: none; border-top: 1px solid #eee;">
        <p style="color: #666; font-size: 12px; text-align: center;">
          Email ini dikirim secara otomatis. Jangan balas email ini.
        </p>
      </div>
    `;

    await sendEmail(tokenData.email, emailSubject, emailHtml);

    return res.status(200).json({
      status: true,
      message: "Password berhasil direset. Anda sekarang dapat login dengan password baru.",
      data: {
        user_name: tokenData.name,
        user_email: tokenData.email,
        reset_at: new Date().toISOString()
      }
    });

  } catch (err) {
    console.error('Reset password error:', err);
    return res.status(500).json({
      status: false,
      error: "Internal server error"
    });
  }
}

module.exports = {
  requestResetPassword,
  verifyResetToken,
  resetPassword
};